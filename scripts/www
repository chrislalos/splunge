#!/usr/bin/env bash

init()
{
    local project_name code_folder bind log_file pythonpath_arg

    if [[ -z "$project_name" ]]; then
        project_name=$(git rev-parse --show-toplevel 2>/dev/null | xargs basename 2>/dev/null || basename "$PWD" 2>/dev/null || printf '')
    fi

    printf 'Splunge first-run setup\n'
    printf 'Enter values or press Enter for defaults.\n\n'

    read -r -p "Project name [${project_name}]: " inp;          project_name=${inp:-$project_name}
    read -r -e -p "Content folder [./web]: " inp;               code_folder=${inp:-'./web'}

    local bind_type="tcp"
    local bind=""
    read -r -p "Bind type (tcp/unix) [${bind_type}]: " inp;     bind_type=${inp:-$bind_type}

    if [[ "$bind_type" == "unix" ]]; then
        local default_sock="/tmp/${project_name:-splunge}.sock"
        read -r -e -p "Socket path [${default_sock}]: " inp;    bind="unix:${inp:-$default_sock}"
    else
        local default_addr="localhost:13000"
        read -r -e -p "Address [${default_addr}]: " inp;        bind=${inp:-$default_addr}
    fi

    read -r -p "Graceful timeout (seconds, blank for default) []: " inp; graceful_timeout=${inp:-''}

    local default_log="$HOME/tmp/${project_name:-splunge}/log/splunge.log"
    read -r -e -p "Log file [${default_log}]: " inp;            log_file=${inp:-$default_log}
    read -r -e -p "Python path (blank for none) []: " inp;      pythonpath_arg=${inp:-''}
    printf '\n'

    mkdir -p "$code_folder" 2>/dev/null

    local generate_site="y"
    read -r -p "Generate a starter site? (Y/n): " inp;            generate_site=${inp:-$generate_site}
    if [[ "$generate_site" =~ ^[Yy]?$ ]]; then
        local _cf="$code_folder"
        cat > "$_cf/index.py" <<'PYEOF'
welcome = "welcome to splunge"
byebye = "have fun(ge)!"
sunmoji = "\U0001f31e"
PYEOF

        cat > "$_cf/style.css" <<'CSSEOF'
body { font-family: sans-serif; text-align: center; margin-top: 20vh; }
#welcome { font-size: 2rem; color: #333; }
#byebye { font-size: 1.2rem; color: #666; margin-top: 1rem; }
.rayray { font-size: 3rem; }
CSSEOF

        cat > "$_cf/index.pyp" <<'HTMLEOF'
<html>
<head>
    <title>splunge</title>
    <link rel='stylesheet' href='/style.css'>
</head>
<body>
    <div id='welcome'>{{ welcome }}</div>
    <div id='byebye'>{{ byebye }}</div>
    <div><span class='rayray'>{{ sunmoji }}</span></div>
</body>
</html>
HTMLEOF
        printf '  Starter site created in %s\n' "$_cf"
    fi

    local config_file="${config_file:-.splunge.env}"
    cat > "$config_file" <<EOF
PROJECT_NAME=$project_name
BIND=$bind
CODEFOLDER=$code_folder
TEMPLATEFOLDER=.
GRACEFUL_TIMEOUT=$graceful_timeout
LOGFILE=$log_file
PYTHONPATH=$pythonpath_arg
EOF
    printf 'Config written to %s\n' "$config_file"
}


main()
{

# Flags
local config_file=""
local flag_bind=""
local flag_code_folder=""
local flag_template_folder=""
local flag_log_file=""
local flag_graceful_timeout=""
local flag_project_name=""
local flag_init=0
local flag_run=0
local flag_no_run=0
local -a pythonpaths=()

while (( $# > 0 )); do
    case $1 in
        --init)
            flag_init=1
            shift
            ;;
        --run)
            flag_run=1
            shift
            ;;
        --no-run)
            flag_no_run=1
            shift
            ;;
        --with-config)
            (( $# >= 2 )) || { printf '--with-config requires a path\n' >&2; return 1 2>/dev/null || exit 1; }
            config_file=$2
            shift 2
            ;;
        --bind)
            (( $# >= 2 )) || { printf '--bind requires a value\n' >&2; return 1 2>/dev/null || exit 1; }
            flag_bind=$2
            shift 2
            ;;
        --code-folder)
            (( $# >= 2 )) || { printf '--code-folder requires a value\n' >&2; return 1 2>/dev/null || exit 1; }
            flag_code_folder=$2
            shift 2
            ;;
        --template-folder)
            (( $# >= 2 )) || { printf '--template-folder requires a value\n' >&2; return 1 2>/dev/null || exit 1; }
            flag_template_folder=$2
            shift 2
            ;;
        --log-file)
            (( $# >= 2 )) || { printf '--log-file requires a value\n' >&2; return 1 2>/dev/null || exit 1; }
            flag_log_file=$2
            shift 2
            ;;
        --graceful-timeout)
            (( $# >= 2 )) || { printf '--graceful-timeout requires a value\n' >&2; return 1 2>/dev/null || exit 1; }
            flag_graceful_timeout=$2
            shift 2
            ;;
        --project-name)
            (( $# >= 2 )) || { printf '--project-name requires a value\n' >&2; return 1 2>/dev/null || exit 1; }
            flag_project_name=$2
            shift 2
            ;;
        --python-path)
            (( $# >= 2 )) || { printf '--python-path requires a value\n' >&2; return 1 2>/dev/null || exit 1; }
            pythonpaths+=("$2")
            shift 2
            ;;
        *)
            printf 'Unknown flag: %s\n' "$1" >&2
            return 1
            ;;
    esac
done

# Source explicit config file if given
if [[ -n "$config_file" ]]; then
    [[ -f "$config_file" ]] || { printf 'Config file not found: %s\n' "$config_file" >&2; return 1 2>/dev/null || exit 1; }
    source "$config_file"
fi

# Config file auto-detection — bare www with no flags
if [[ -z "$config_file" && "$flag_init" -eq 0 && -z "$flag_bind" && -z "$flag_code_folder" && -z "$flag_template_folder" && -z "$flag_log_file" && -z "$flag_project_name" ]]; then
    if [[ -f ".splunge.env" ]]; then
        source ".splunge.env"
    fi
fi

# Resolve each value: flag > config short name > default
bind=${flag_bind:-${BIND:-localhost:13000}}
code_folder=${flag_code_folder:-${CODEFOLDER:-'.'}}
template_folder=${flag_template_folder:-${TEMPLATEFOLDER:-''}}
log_file=${flag_log_file:-${LOGFILE:-"$HOME/tmp/splunge/log/splunge.log"}}

graceful_timeout=${flag_graceful_timeout:-${GRACEFUL_TIMEOUT:-''}}
project_name=${flag_project_name:-${PROJECT_NAME:-''}}

# Python path: flags array > SPLUNGE_PYTHONPATH > PYTHONPATH (config)
if (( ${#pythonpaths[@]} == 0 )); then
    if [[ -n "$SPLUNGE_PYTHONPATH" ]]; then
        pythonpaths=("$SPLUNGE_PYTHONPATH")
    elif [[ -n "$PYTHONPATH" ]]; then
        pythonpaths=("$PYTHONPATH")
    fi
fi

# Init mode — prompt, save config, optionally run
need_init=0
if [[ "$flag_init" -eq 1 ]]; then
    need_init=1
elif [[ -z "$config_file" && -z "$flag_bind" && -z "$flag_code_folder" && -z "$flag_template_folder" && -z "$flag_log_file" && -z "$flag_project_name" && ! -f ".splunge.env" && -z "$BIND" && -z "$CODEFOLDER" && -z "$TEMPLATEFOLDER" && -z "$LOGFILE" && -z "$GRACEFUL_TIMEOUT" && -z "$PROJECT_NAME" ]]; then
    need_init=1
fi

if [[ "$need_init" -eq 1 ]]; then
    init

    # Re-source the config we just wrote and re-resolve
    source ".splunge.env"
    bind=${flag_bind:-${BIND:-localhost:13000}}
    code_folder=${flag_code_folder:-${CODEFOLDER:-'.'}}
    template_folder=${flag_template_folder:-${TEMPLATEFOLDER:-''}}
    log_file=${flag_log_file:-${LOGFILE:-"$HOME/tmp/splunge/log/splunge.log"}}
    graceful_timeout=${flag_graceful_timeout:-${GRACEFUL_TIMEOUT:-''}}
    project_name=${flag_project_name:-${PROJECT_NAME:-''}}
    if (( ${#pythonpaths[@]} == 0 )); then
        if [[ -n "$SPLUNGE_PYTHONPATH" ]]; then
            pythonpaths=("$SPLUNGE_PYTHONPATH")
        elif [[ -n "$PYTHONPATH" ]]; then
            pythonpaths=("$PYTHONPATH")
        fi
    fi

    if [[ "$flag_run" -eq 0 && "$flag_no_run" -eq 0 ]]; then
        read -r -p "Run the app now? (Y/n): " inp
        flag_run=1
        [[ "$inp" =~ ^[Nn] ]] && flag_run=0
    fi

    if [[ "$flag_run" -eq 0 ]]; then
        return 0 2>/dev/null || exit 0
    fi
fi

# Resolve relative paths to absolute so they don't shift after --chdir
code_folder=$(realpath -- "$code_folder" 2>/dev/null || readlink -f -- "$code_folder" 2>/dev/null || printf '%s' "$code_folder")
[[ -z "$template_folder" ]] && template_folder=$code_folder
template_folder=$(realpath -- "$template_folder" 2>/dev/null || readlink -f -- "$template_folder" 2>/dev/null || printf '%s' "$template_folder")

# Validate required values
[[ -d "$code_folder" ]] || { printf 'Content folder not found: %s\n' "$code_folder" >&2; return 1 2>/dev/null || exit 1; }

log_folder=$(dirname "$log_file")
mkdir -p "$log_folder" || { printf 'Unable to create log folder %s\n' "$log_folder" >&2; return 1 2>/dev/null || exit 1; }

# Startup message
if [[ "$bind" == unix:* ]]; then
    printf 'Splunge serving %s on socket %s\n' "$code_folder" "${bind#unix:}"
else
    printf 'Splunge serving %s on %s; logging to %s\n' "$code_folder" "$bind" "$log_file"
fi

flags=(
    --bind "$bind"
    --access-logfile "$log_folder/access.log"
    --chdir "$code_folder"
    --env "SPLUNGE_CODEFOLDER=$code_folder"
    --env "SPLUNGE_TEMPLATEFOLDER=$template_folder"
    --env "SPLUNGE_TEMPLATE_FOLDER=$template_folder"
    --env "SPLUNGE_LOGFILE=$log_file"
    --error-logfile "$log_folder/errors.log"
    --workers 3
    --umask 007
    --reload
)

[[ -n "$graceful_timeout" ]] && flags+=(--graceful-timeout "$graceful_timeout")

if (( ${#pythonpaths[@]} > 0 )); then
    local IFS=':'
    export PYTHONPATH="${pythonpaths[*]}:${PYTHONPATH:-}"
fi

exec gunicorn "${flags[@]}" splunge.app:app
}

(return 0 2>/dev/null) || main "$@"
