#!/usr/bin/env bash

DEFAULT_PORT=80

# Flags
config_file=""
flag_port=""
flag_host=""
flag_socket=""
flag_code_folder=""
flag_templates_folder=""
flag_log_file=""
flag_graceful_timeout=""
flag_project_name=""
init_mode=0

while (( $# > 0 )); do
    case $1 in
        init)
            init_mode=1
            shift
            ;;
        --with-config)
            (( $# >= 2 )) || { printf '--with-config requires a path\n' >&2; return 1 2>/dev/null || exit 1; }
            config_file=$2
            shift 2
            ;;
        --port)
            (( $# >= 2 )) || { printf '--port requires a value\n' >&2; return 1 2>/dev/null || exit 1; }
            flag_port=$2
            shift 2
            ;;
        --host)
            (( $# >= 2 )) || { printf '--host requires a value\n' >&2; return 1 2>/dev/null || exit 1; }
            flag_host=$2
            shift 2
            ;;
        --socket)
            (( $# >= 2 )) || { printf '--socket requires a value\n' >&2; return 1 2>/dev/null || exit 1; }
            flag_socket=$2
            shift 2
            ;;
        --code-folder)
            (( $# >= 2 )) || { printf '--code-folder requires a value\n' >&2; return 1 2>/dev/null || exit 1; }
            flag_code_folder=$2
            shift 2
            ;;
        --templates-folder)
            (( $# >= 2 )) || { printf '--templates-folder requires a value\n' >&2; return 1 2>/dev/null || exit 1; }
            flag_templates_folder=$2
            shift 2
            ;;
        --log-file)
            (( $# >= 2 )) || { printf '--log-file requires a value\n' >&2; return 1 2>/dev/null || exit 1; }
            flag_log_file=$2
            shift 2
            ;;
        --graceful-timeout)
            (( $# >= 2 )) || { printf '--graceful-timeout requires a value\n' >&2; return 1 2>/dev/null || exit 1; }
            flag_graceful_timeout=$2
            shift 2
            ;;
        --project-name)
            (( $# >= 2 )) || { printf '--project-name requires a value\n' >&2; return 1 2>/dev/null || exit 1; }
            flag_project_name=$2
            shift 2
            ;;
        *)
            printf 'Unknown flag: %s\n' "$1" >&2
            return 1
            ;;
    esac
done

# Source explicit config file if given
if [[ -n "$config_file" ]]; then
    [[ -f "$config_file" ]] || { printf 'Config file not found: %s\n' "$config_file" >&2; return 1 2>/dev/null || exit 1; }
    source "$config_file"
fi

# Config file auto-detection — bare www with no flags, no env vars
if [[ -z "$config_file" && "$init_mode" -eq 0 && -z "$flag_port" && -z "$flag_socket" && -z "$flag_code_folder" && -z "$flag_host" && -z "$flag_templates_folder" && -z "$flag_log_file" && -z "$flag_project_name" ]]; then
    if [[ -f ".splunge.env" ]]; then
        source ".splunge.env"
    fi
fi

# Resolve each value: flag > env var > config file > default
port=${flag_port:-${SPLUNGE_PORT:-$DEFAULT_PORT}}
host=${flag_host:-${SPLUNGE_HOST:-localhost}}
socket_path=${flag_socket:-${SPLUNGE_SOCKET:-''}}
code_folder=${flag_code_folder:-${SPLUNGE_CODEFOLDER:-'.'}}
templates_folder=${flag_templates_folder:-${SPLUNGE_TEMPLATES_FOLDER:-'./templates'}}
log_file=${flag_log_file:-${SPLUNGE_LOGFILE:-"$HOME/tmp/splunge/log/splunge.log"}}

graceful_timeout=${flag_graceful_timeout:-${SPLUNGE_GRACEFUL_TIMEOUT:-''}}
project_name=${flag_project_name:-${SPLUNGE_PROJECT_NAME:-''}}

# Validate mutual exclusivity
if [[ -n "$socket_path" && -n "$flag_port" ]]; then
    printf '%s\n' '--port and --socket are mutually exclusive' >&2
    return 1 2>/dev/null || exit 1
fi
if [[ -n "$socket_path" && -n "$flag_host" ]]; then
    printf '%s\n' '--host has no effect with --socket' >&2
fi

# Init mode — prompt and save config
need_init=0
if [[ "$init_mode" -eq 1 ]]; then
    need_init=1
elif [[ -z "$config_file" && -z "$flag_port" && -z "$flag_socket" && -z "$flag_code_folder" && -z "$flag_templates_folder" && -z "$flag_log_file" && -z "$flag_project_name" && ! -f ".splunge.env" && -z "$SPLUNGE_PORT" && -z "$SPLUNGE_SOCKET" && -z "$SPLUNGE_CODEFOLDER" && -z "$SPLUNGE_HOST" && -z "$SPLUNGE_TEMPLATES_FOLDER" && -z "$SPLUNGE_LOGFILE" && -z "$SPLUNGE_PROJECT_NAME" ]]; then
    need_init=1
fi

if [[ "$need_init" -eq 1 ]]; then
    # Derive default project name from git remote or current dir
    if [[ -z "$project_name" ]]; then
        project_name=$(git rev-parse --show-toplevel 2>/dev/null | xargs basename 2>/dev/null || basename "$PWD" 2>/dev/null || printf '')
    fi

    printf 'Splunge first-run setup\n'
    printf 'Enter values or press Enter for defaults.\n\n'

    read -r -p "Project name [${project_name}]: " inp;          project_name=${inp:-$project_name}
    read -r -p "Content folder [./web]: " inp;                  code_folder=${inp:-'./web'}
    templates_folder=$code_folder

    local bind_type="tcp"
    read -r -p "Bind type (tcp/unix) [${bind_type}]: " inp;     bind_type=${inp:-$bind_type}

    if [[ "$bind_type" == "unix" ]]; then
        local default_sock="/tmp/${project_name:-splunge}.sock"
        read -r -p "Socket path [${default_sock}]: " inp;       socket_path=${inp:-$default_sock}
        port=""
        host=""
    else
        read -r -p "Host [${host}]: " inp;                      host=${inp:-$host}
        read -r -p "Port [${port}]: " inp;                      port=${inp:-$port}
        socket_path=""
    fi

    read -r -p "Graceful timeout (seconds, blank for default) []: " inp; graceful_timeout=${inp:-''}

    local default_log="$HOME/tmp/${project_name:-splunge}/log/splunge.log"
    read -r -p "Log file [${default_log}]: " inp;               log_file=${inp:-$default_log}
    printf '\n'

    # Create content folder if missing
    mkdir -p "$code_folder" 2>/dev/null

    config_file=${config_file:-.splunge.env}
    cat > "$config_file" <<EOF
SPLUNGE_PROJECT_NAME=$project_name
SPLUNGE_PORT=$port
SPLUNGE_HOST=$host
SPLUNGE_SOCKET=$socket_path
SPLUNGE_CODEFOLDER=$code_folder
SPLUNGE_TEMPLATES_FOLDER=$templates_folder
SPLUNGE_GRACEFUL_TIMEOUT=$graceful_timeout
SPLUNGE_LOGFILE=$log_file
EOF
    printf 'Config written to %s\n' "$config_file"
    return 0 2>/dev/null || exit 0
fi

# Validate required values
[[ -d "$code_folder" ]] || { printf 'Content folder not found: %s\n' "$code_folder" >&2; return 1 2>/dev/null || exit 1; }

log_folder=$(dirname "$log_file")
mkdir -p "$log_folder" || { printf 'Unable to create log folder %s\n' "$log_folder" >&2; return 1 2>/dev/null || exit 1; }

# Build gunicorn bind string
if [[ -n "$socket_path" ]]; then
    bind_str="unix:$socket_path"
    printf 'Splunge serving %s on socket %s\n' "$code_folder" "$socket_path"
else
    bind_str="$host:$port"
    printf 'Splunge serving %s on %s; logging to %s\n' "$code_folder" "$bind_str" "$log_file"
fi

flags=(
    --bind "$bind_str"
    --access-logfile "$log_folder/access.log"
    --chdir "$code_folder"
    --env "SPLUNGE_CODEFOLDER=$code_folder"
    --env "SPLUNGE_TEMPLATE_FOLDER=$templates_folder"
    --env "SPLUNGE_LOGFILE=$log_file"
    --error-logfile "$log_folder/errors.log"
    --workers 3
    --umask 007
    --reload
)

[[ -n "$graceful_timeout" ]] && flags+=(--graceful-timeout "$graceful_timeout")

exec gunicorn "${flags[@]}" splunge.app:app